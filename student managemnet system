
import java.util.ArrayList;
import java.util.Scanner;

public class StudentManagementSystem {

    static Scanner sc = new Scanner(System.in);
    static ArrayList<String> names = new ArrayList<>();
    static ArrayList<Integer> ids = new ArrayList<>();
    static ArrayList<String> courses = new ArrayList<>();

    public static void main(String[] args) {

        int choice;

        do {
            System.out.println("\n===== STUDENT MANAGEMENT SYSTEM =====");
            System.out.println("1. Add Student");
            System.out.println("2. Display Students");
            System.out.println("3. Search Student");
            System.out.println("4. Update Student");
            System.out.println("5. Delete Student");
            System.out.println("6. Exit");

            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            switch (choice) {

                case 1:
                    System.out.print("Enter Student ID: ");
                    int id = sc.nextInt();
                    sc.nextLine();

                    if (ids.contains(id)) {
                        System.out.println("Student ID already exists!");
                        break;
                    }

                    System.out.print("Enter Student Name: ");
                    String name = sc.nextLine();

                    System.out.print("Enter Course: ");
                    String course = sc.nextLine();

                    ids.add(id);
                    names.add(name);
                    courses.add(course);

                    System.out.println("Student Added Successfully!");
                    break;

                case 2:
                    if (ids.isEmpty()) {
                        System.out.println("No Student Records Found!");
                    } else {
                        System.out.println("\nStudent Details:");

                        for (int i = 0; i < ids.size(); i++) {
                            System.out.println("ID: " + ids.get(i));
                            System.out.println("Name: " + names.get(i));
                            System.out.println("Course: " + courses.get(i));
                            System.out.println("----------------------");
                        }
                    }
                    break;

                case 3:
                    System.out.print("Enter Student ID: ");
                    int searchId = sc.nextInt();

                    int index = ids.indexOf(searchId);

                    if (index != -1) {
                        System.out.println("Student Found!");
                        System.out.println("Name: " + names.get(index));
                        System.out.println("Course: " + courses.get(index));
                    } else {
                        System.out.println("Student Not Found!");
                    }
                    break;

                case 4:
                    System.out.print("Enter Student ID to Update: ");
                    int updateId = sc.nextInt();
                    sc.nextLine();

                    int updateIndex = ids.indexOf(updateId);

                    if (updateIndex != -1) {
                        System.out.print("Enter New Name: ");
                        names.set(updateIndex, sc.nextLine());

                        System.out.print("Enter New Course: ");
                        courses.set(updateIndex, sc.nextLine());

                        System.out.println("Student Updated Successfully!");
                    } else {
                        System.out.println("Student Not Found!");
                    }
                    break;

                case 5:
                    System.out.print("Enter Student ID to Delete: ");
                    int deleteId = sc.nextInt();

                    int deleteIndex = ids.indexOf(deleteId);

                    if (deleteIndex != -1) {
                        ids.remove(deleteIndex);
                        names.remove(deleteIndex);
                        courses.remove(deleteIndex);

                        System.out.println("Student Deleted Successfully!");
                    } else {
                        System.out.println("Student Not Found!");
                    }
                    break;

                case 6:
                    System.out.println("Thank You!");
                    break;

                default:
                    System.out.println("Invalid Choice!");
            }

        } while (choice != 6);

        sc.close();
    }
}
